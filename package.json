{
  "name": "leesandleef-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/index.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
