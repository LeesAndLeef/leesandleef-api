DATABASE_URL=postgres://postgres:postgres@localhost:5433/leesandleef
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# At least 32 random characters each, e.g. from `openssl rand -base64 48`
JWT_SECRET=
COOKIE_SECRET=

# Payments: without these, card payments are faked and succeed immediately
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: without a key, emails are written to the log instead
RESEND_API_KEY=
EMAIL_FROM=Lees & Leaf <orders@your-domain.com>
EMAIL_REPLY_TO=

# Bank transfer: leave BANK_IBAN empty to turn the option off
BANK_BENEFICIARY=Lees & Leaf d.o.o.
BANK_IBAN=HR1210010051863000160
BANK_BIC=
